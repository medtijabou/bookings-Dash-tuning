
<mvc:View
    id="appView"
    controllerName="etudiant14.sap.training.helloworld.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    displayBlock="true"
    height="100%">

    <tnt:ToolPage id="toolPage">
        <tnt:header>
            <tnt:ToolHeader id="toolHeader">
                <Button
                    id="menuButton"
                    icon="sap-icon://menu2"
                    type="Transparent"
                    press=".onToggleMenu">
                    <layoutData>
                        <OverflowToolbarLayoutData
                            id="menuButtonLayoutData"
                            priority="NeverOverflow"/>
                    </layoutData>
                </Button>

                <Title
                    id="appTitle"
                    text="{i18n>title}"
                    level="H1"/>

                <ToolbarSpacer id="headerSpacer"/>

                <Avatar
                    id="userAvatar"
                    initials="SB"
                    displaySize="XS"
                    backgroundColor="Accent8"/>
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation
                id="sideNav"
                selectedKey="dashboard"
                itemSelect=".onItemSelect">

                <tnt:NavigationList id="navigationList">
                    <tnt:NavigationListItem
                        id="navDashboard"
                        text="{i18n>navDashboard}"
                        icon="sap-icon://business-objects-experience"
                        key="dashboard"/>

                    <tnt:NavigationListItem
                        id="navCustomers"
                        text="{i18n>navCustomers}"
                        icon="sap-icon://customer"
                        key="customers"/>

                    <tnt:NavigationListItem
                        id="navBookings"
                        text="{i18n>navBookings}"
                        icon="sap-icon://flight"
                        key="bookings"/>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <App id="app"/>
        </tnt:mainContents>
    </tnt:ToolPage>
</mvc:View>
