
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog id="bookingDialog"
        title="{i18n>bookingDialogTitle} {sel>/BookingNumber}"
        contentWidth="22rem">

        <form:SimpleForm
            id="bookingDetailsForm"
            editable="false"
            layout="ResponsiveGridLayout"
            labelSpanXL="12"
            labelSpanL="12"
            labelSpanM="12"
            labelSpanS="12"
            emptySpanXL="0"
            emptySpanL="0"
            emptySpanM="0"
            emptySpanS="0"
            columnsXL="1"
            columnsL="1"
            columnsM="1">

            <Label id="customerLabel" text="{i18n>customerColumn}"/>
            <Text id="customerText" text="{sel>/Customer}"/>

            <Label id="airlineLabel" text="{i18n>airlineColumnHeader}"/>
            <Text id="airlineText" text="{sel>/AirlineID} {sel>/ConnectionNumber}"/>

            <Label id="flightDateLabel" text="{i18n>fldateColumnHeader}"/>
            <Text id="flightDateText"
                text="{path: 'sel>/FlightDate', type: 'sap.ui.model.type.Date', formatOptions: {source: {pattern: 'yyyy-MM-dd'}, style: 'long'}}"/>

            <Label id="bookingDateLabel" text="{i18n>bookingDateLabel}"/>
            <Text id="bookingDateText"
                text="{path: 'sel>/BookingDate', type: 'sap.ui.model.type.Date', formatOptions: {source: {pattern: 'yyyy-MM-dd'}, style: 'long'}}"/>

            <Label id="classLabel" text="{i18n>classColumnHeader}"/>
            <Text id="classText"
                text="{= ${sel>/Class} === 'C' ? ${i18n>flightClassC} : ${sel>/Class} === 'F' ? ${i18n>flightClassF} : ${i18n>flightClassY} }"/>

            <Label id="amountLabel" text="{i18n>amountColumn}"/>
            <ObjectNumber
    id="bookingAmount"
    number="{sel>/Amount}"
    unit="{sel>/ForeignCurrency}"/>

            <Label id="cancellationLabel" text="{i18n>cancellationColumnHeader}"/>
            <ObjectStatus
                id="bookingStatus"
                text="{= ${sel>/Cancelled} ? ${i18n>statusCancelled} : ${i18n>statusActive} }"
                state="{= ${sel>/Cancelled} ? 'Error' : 'Success' }"/>

        </form:SimpleForm>

        <beginButton>
            <Button
                id="cancelBookingButton"
                text="{i18n>cancelBookingButton}"
                icon="sap-icon://sys-cancel-2"
                type="Reject"
                enabled="{= !${sel>/Cancelled} }"
                press=".onCancelBooking"/>
        </beginButton>

        <endButton>
            <Button
                id="closeBookingDialogButton"
                text="{i18n>closeButton}"
                press=".onCloseDialog"/>
        </endButton>

    </Dialog>
</core:FragmentDefinition>
