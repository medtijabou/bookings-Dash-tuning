<mvc:View
    controllerName="etudiant14.sap.training.helloworld.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:uxap="sap.uxap"
    xmlns:form="sap.ui.layout.form"
    core:require="{formatter: 'etudiant14/sap/training/helloworld/model/formatter'}"
    displayBlock="true">

    <uxap:ObjectPageLayout id="detailPage" upperCaseAnchorBar="false">

        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:breadcrumbs>
                    <Breadcrumbs currentLocationText="{d>/c/CustomerName}">
                        <links>
                            <Link text="{i18n>navDashboard}" press=".onNav('RouteDashboard')"/>
                            <Link text="{i18n>navBookings}" press=".onNav('RouteBookings')"/>
                        </links>
                    </Breadcrumbs>
                </uxap:breadcrumbs>
                <uxap:heading><Title text="{d>/c/Form} {d>/c/CustomerName}"/></uxap:heading>
                <uxap:expandedContent><Text text="{d>/c/City}, {d>/c/Country}"/></uxap:expandedContent>
                <uxap:actions>
                    <Button icon="sap-icon://nav-back" text="Back" type="Transparent" press=".onNavBack"/>
                </uxap:actions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <HBox alignItems="Center" wrap="Wrap">
                <Avatar initials="{d>/initials}" displaySize="L" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
                <VBox class="sapUiMediumMarginEnd">
                    <ObjectAttribute title="{i18n>customerNumberTitle}" text="{d>/c/CustomerNumber}"/>
                    <Label text="{i18n>emailTitle}"/>
                    <Link text="{d>/c/Email}" href="{= 'mailto:' + ${d>/c/Email} }"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd">
                    <Label text="{i18n>discountTitle}"/>
                    <NumericContent value="{d>/c/Discount}" scale="%" withMargin="false" truncateValueTo="5"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd">
                    <Label text="{i18n>bookingsLabel}"/>
                    <ObjectNumber number="{d>/n}" emphasized="true"/>
                </VBox>
                <VBox>
                    <Label text="{i18n>cancellationRateLabel}"/>
                    <ProgressIndicator width="12rem" percentValue="{d>/rate}"
                                       displayValue="{d>/rate} %" state="{d>/rateState}"/>
                </VBox>
            </HBox>
        </uxap:headerContent>

        <uxap:sections>
            <!-- Informations générales -->
            <uxap:ObjectPageSection title="{i18n>generalInformation}">
                <uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
                    <form:SimpleForm editable="false" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">
                        <core:Title text="{i18n>addressDataFormContainerTitle}"/>
                        <Label text="{i18n>streetTitle}"/><Text text="{d>/c/Street}"/>
                        <Label text="{i18n>postcodeTitle}"/><Text text="{d>/c/PostCode}"/>
                        <Label text="{i18n>cityTitle}"/><Text text="{d>/c/City}"/>
                        <Label text="{i18n>countryTitle}"/><Text text="{d>/c/Country}"/>
                        <core:Title text="{i18n>contactDataFormContainerTitle}"/>
                        <Label text="{i18n>emailTitle}"/><Link text="{d>/c/Email}" href="{= 'mailto:' + ${d>/c/Email} }"/>
                        <Label text="{i18n>phoneTitle}"/><Link text="{d>/c/Telephone}" href="{= 'tel:' + ${d>/c/Telephone} }"/>
                    </form:SimpleForm>
                </uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Réservations du client, filtrables par statut -->
            <uxap:ObjectPageSection title="{i18n>bookingsTitle}">
                <uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
                    <IconTabBar id="statusTabs" select=".onTabSelect" expandable="false" applyContentPadding="false">
                        <items>
                            <IconTabFilter key="all" showAll="true" count="{d>/n}" text="{i18n>statusAll}"/>
                            <IconTabSeparator/>
                            <IconTabFilter key="active" icon="sap-icon://accept" iconColor="Positive" count="{d>/active}" text="{i18n>statusActive}"/>
                            <IconTabFilter key="cancelled" icon="sap-icon://sys-cancel-2" iconColor="Negative" count="{d>/cancelled}" text="{i18n>statusCancelled}"/>
                        </items>
                        <content>
                            <Table items="{d>/shown}" growing="true" growingThreshold="10">
                                <columns>
                                    <Column><Text text="{i18n>bookingColumn}"/></Column>
                                    <Column><Text text="{i18n>airlineColumnHeader}"/></Column>
                                    <Column><Text text="{i18n>fldateColumnHeader}"/></Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true"><Text text="{i18n>classColumnHeader}"/></Column>
                                    <Column hAlign="End"><Text text="{i18n>amountColumn}"/></Column>
                                    <Column><Text text="{i18n>cancellationColumnHeader}"/></Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{d>BookingNumber}"/>
                                            <Text text="{d>AirlineID} {d>ConnectionNumber}"/>
                                            <Text text="{path: 'd>FlightDate', type: 'sap.ui.model.type.Date', formatOptions: {source: {pattern: 'yyyy-MM-dd'}, style: 'medium'}}"/>
                                            <Text text="{path: 'd>Class', formatter: 'formatter.classText'}"/>
                                            <ObjectNumber number="{parts: ['d>Amount', 'd>ForeignCurrency'], type: 'sap.ui.model.type.Currency', formatOptions: {showMeasure: false}}"
                                                          unit="{d>ForeignCurrency}"/>
                                            <ObjectStatus text="{= ${d>Cancelled} ? ${i18n>statusCancelled} : ${i18n>statusActive} }"
                                                          state="{= ${d>Cancelled} ? 'Error' : 'Success' }"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </content>
                    </IconTabBar>
                </uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Compagnies utilisées -->
            <uxap:ObjectPageSection title="{i18n>airlinesSection}">
                <uxap:subSections><uxap:ObjectPageSubSection><uxap:blocks>
                    <List items="{d>/airlines}">
                        <StandardListItem icon="sap-icon://flight" title="{d>id}"
                                          description="{= ${i18n>cancelledCount}.replace('{0}', ${d>cancelled}) }"
                                          info="{d>total}" infoState="Information"/>
                    </List>
                </uxap:blocks></uxap:ObjectPageSubSection></uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>
